# Copy to `.env` and fill in real values. Never commit `.env`.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public base URL, used to build the certificate verification link encoded in
# the QR code. Must be the real origin in production or scanned QR codes will
# point at localhost.
#   local:      http://localhost:3000
#   production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (Phase 2)
# ---------------------------------------------------------------------------
# PostgreSQL connection string. Use a pooled connection URL on Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ---------------------------------------------------------------------------
# Photo storage — Vercel Blob (Phase 4)
# ---------------------------------------------------------------------------
# Created under Vercel > Storage > Blob. Server-side only; never expose it to
# the client.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Default administrator (used by `npm run admin:create` only)
# ---------------------------------------------------------------------------
# The seed script reads these; they are never read by the running application.
# The account is always created with "must change password" set, so the
# password below is a bootstrap credential, not a usable one.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Administrator

# ---------------------------------------------------------------------------
# Payment instructions — initial values only
# ---------------------------------------------------------------------------
# Shown to registrants until an administrator saves the payment settings in the
# dashboard (Admin > Payment information). Once saved, the database row wins and
# these are ignored. Leave the account fields empty to have the app tell
# registrants that payment details have not been published yet.
PAYMENT_METHOD=Bank transfer
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ADDRESS=
PAYMENT_AMOUNT=
PAYMENT_INSTRUCTIONS=

# ---------------------------------------------------------------------------
# Connection pool
# ---------------------------------------------------------------------------
# Size of the `pg` pool. NOTE: `?connection_limit=` in DATABASE_URL does NOT
# apply when using a Prisma driver adapter — the pool is pg's own. Keep this
# small on serverless: every warm instance holds its own pool.
# Set to 1 when using the local `prisma dev` (PGlite) server, which cannot serve
# concurrent Prisma transactions.
DATABASE_POOL_MAX=5

# Shadow database, used by `prisma migrate dev` only. Not needed in production.
SHADOW_DATABASE_URL=
